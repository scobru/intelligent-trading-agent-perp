# ==============================================================================
# OpenRouter AI Configuration
# ==============================================================================
OPENROUTER_API_KEY="sk-or-v1-tua-chiave-openrouter-qui"
# Modello usato per le decisioni di trading (default: openrouter/free).
# I router gratuiti a volte restituiscono risposte vuote: in quel caso
# imposta un modello specifico, es. "openai/gpt-4o-mini".
OPENROUTER_MODEL="openrouter/free"
# Tentativi prima di ripiegare su un segnale 'hold' di sicurezza
OPENROUTER_MAX_ATTEMPTS="3"

# ==============================================================================
# SynFutures (Base Chain) Configuration
# ==============================================================================
# Indirizzo wallet e chiave privata del signer per SynFutures su rete Base
SYNFUTURES_WALLET="0xTuoWalletAddressQui"
SYNFUTURES_PRIVATE_KEY="tua-private-key-di-synfutures-qui"

# Endpoint microservizio SynFutures Node.js (default: http://localhost:3100)
SYNFUTURES_SERVICE_URL="http://localhost:3100"

# RPC Endpoint per Base Network (opzionale, default: https://mainnet.base.org)
BASE_RPC="https://mainnet.base.org"

# API Key condivisa con il microservizio (opzionale)
API_KEY="chiave-segreta-microservizio"

# ==============================================================================
# Database Locale SQLite (db_utils.py)
# ==============================================================================
# Nessun server esterno necessario: SQLite crea automaticamente il file locale.
# Opzionale: specifica un percorso personalizzato se desiderato.
SQLITE_DB_PATH="trading_agent.db"

# ==============================================================================
# Sentiment Analysis
# ==============================================================================
# Di default il bot utilizza il servizio GRATUITO di Alternative.me (nessuna chiave richiesta).
# Se vuoi usare CoinMarketCap come fonte alternativa, puoi impostare la chiave qui sotto (opzionale):
# CMC_PRO_API_KEY="tua-cmc-pro-api-key"

# ==============================================================================
# Telegram Bot & Notifiche (Opzionale)
# ==============================================================================
# Inserisci il token del bot (creato con @BotFather) e il tuo chat_id
# per ricevere report ad ogni trade e comandare il bot da Telegram (/status, /run, /positions)
TELEGRAM_BOT_TOKEN="tuo-telegram-bot-token"
TELEGRAM_CHAT_ID="tuo-telegram-chat-id"
